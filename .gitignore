# Build artifacts
bin/
obj/
out/

# User-specific files
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates

# Logs
*.log

# Visual Studio / VS Code
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider / JetBrains
.idea/
*.sln.iml

# NuGet
*.nupkg
*.snupkg
packages/
!**/packages/build/

# Publish output
publish/
publish-web/
publish-desktop/
wwwroot/dist/

# Firebase Hosting deploy output: generated by deploy-firebase.ps1 / the CI workflow,
# never hand-edited or committed (avoids stale/binary build output in git history).
Firebase/public/

# Desktop wrapper: bundled web output (generated from the published web app)
Desktop/wwwroot/

# Desktop wrapper: optional runtime debug log (enabled via BMED_DEBUG)
bmed-debug.log

# Test and coverage
TestResults/
coverage/
*.coverage
*.coveragexml

# OS files
.DS_Store
Thumbs.db

# Local app settings / secrets
appsettings.Development.json
secrets.json
